<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for Seed v0.1.

  The embedded backend and webapp use plain HTTP on
  the device's loopback. Android 9+ blocks cleartext
  HTTP by default, so we opt in only for the two
  hosts the app supports:

    - 127.0.0.1 — the device's own loopback and the
      default for the embedded backend and webapp.
    - 10.0.2.2 — the emulator's alias for the host
      machine's loopback, retained for development
      against services running on the host.

  This is intentionally narrower than
  `android:usesCleartextTraffic="true"`, which would
  allow cleartext to *every* host — the WebView's
  `shouldOverrideUrlLoading` allowlist is the second
  layer of defence (see `WebViewConfig.isAllowedUrl`),
  and this config is the first. Two layers, both
  narrow.

  The WebView defaults to the embedded webapp at
  `http://127.0.0.1:7778/`; 10.0.2.2 remains in the
  list for emulator-based host development.
-->
<network-security-config>
    <!-- Default: HTTPS only, no cleartext. -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
      Narrow cleartext exception for the two
      supported hosts.
      `cleartextTrafficPermitted="true"` here scopes the
      cleartext permission to these domains only — every
      other host still gets the default (HTTPS only).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
