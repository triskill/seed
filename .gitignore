android/app/src/main/jniLibs/arm64-v8a/libtasn1.so
android/app/src/main/jniLibs/arm64-v8a/libunistring.so
android/app/src/main/jniLibs/arm64-v8a/libz.so
android/app/src/main/jniLibs/arm64-v8a/libzstd.so

# Generated by scripts/build-runtime.sh from backend/pyproject.toml
# via `uv pip compile`. The pyproject is the source of truth; this
# file is a build artifact, regenerated on every rootfs build.
backend/requirements.txt

# Makefile runtime artifacts (emulator/backend PIDs and logs)
backend.pid
emulator.pid
.tmp/

# Build-time working dir for the Android runtime (Task 7.1).
# Lives at repo root, NOT under android/app/src/main/assets/linux/
# (which is tracked and ships with the APK).
runtime-build/

# Allow the assets/linux/ dir to be tracked even though the
# generic `linux/` pattern above would match it.
!android/app/src/main/assets/linux/
!android/app/src/main/assets/linux/seed_version.json
