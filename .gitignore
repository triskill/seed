# Architecture-selected native executables generated by scripts/build-runtime.sh.
# Keep these paths exact so future jniLibs source files remain trackable.
android/app/src/main/jniLibs/arm64-v8a/libproot.so
android/app/src/main/jniLibs/arm64-v8a/libproot-loader.so
android/app/src/main/jniLibs/arm64-v8a/libtalloc.so
android/app/src/main/jniLibs/arm64-v8a/libandroid-shmem.so
android/app/src/main/jniLibs/x86_64/libproot.so
android/app/src/main/jniLibs/x86_64/libproot-loader.so
android/app/src/main/jniLibs/x86_64/libtalloc.so
android/app/src/main/jniLibs/x86_64/libandroid-shmem.so

# ARM64 Android QEMU x86_64 compatibility bundle generated by
# scripts/package-qemu-x86.sh. Keep names exact: future app-owned JNI sources
# remain trackable while the downloaded Termux runtime closure stays local.
android/app/src/main/jniLibs/arm64-v8a/libqemu-x86-64.so
android/app/src/main/jniLibs/arm64-v8a/libandroid-support.so
android/app/src/main/jniLibs/arm64-v8a/libargp.so
android/app/src/main/jniLibs/arm64-v8a/libbz2.so
android/app/src/main/jniLibs/arm64-v8a/libdw.so
android/app/src/main/jniLibs/arm64-v8a/libelf.so
android/app/src/main/jniLibs/arm64-v8a/libffi.so
android/app/src/main/jniLibs/arm64-v8a/libglib-2.0.so
android/app/src/main/jniLibs/arm64-v8a/libgmodule-2.0.so
android/app/src/main/jniLibs/arm64-v8a/libgmp.so
android/app/src/main/jniLibs/arm64-v8a/libgnutls.so
android/app/src/main/jniLibs/arm64-v8a/libhogweed.so
android/app/src/main/jniLibs/arm64-v8a/libiconv.so
android/app/src/main/jniLibs/arm64-v8a/libidn2.so
android/app/src/main/jniLibs/arm64-v8a/liblzma.so
android/app/src/main/jniLibs/arm64-v8a/libnettle.so
android/app/src/main/jniLibs/arm64-v8a/libp11-kit.so
android/app/src/main/jniLibs/arm64-v8a/libpcre2-8.so
